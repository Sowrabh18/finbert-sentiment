# Virtual environment
venv/

# Python cache
__pycache__/
*.py[cod]
*.egg-info/

# Data & models — these go to DVC/S3, never Git
# Data & models — the actual files go to DVC/S3, never Git.
# We ignore data files by TYPE (not the whole folder) so Git can still
# see and track the small .dvc receipts inside data/.
/data/**/*.csv
/models/**/*.pkl
/models/**/*.bin
/models/**/*.pt
/models/**/*.safetensors

# DVC internals
/.dvc/cache
/.dvc/tmp

# MLflow local tracking
mlruns/

# Environment secrets (AWS keys etc.) — NEVER commit these
.env
*.pem

# OS / editor noise
.DS_Store
.vscode/
*.log

# Jupyter
.ipynb_checkpoints/